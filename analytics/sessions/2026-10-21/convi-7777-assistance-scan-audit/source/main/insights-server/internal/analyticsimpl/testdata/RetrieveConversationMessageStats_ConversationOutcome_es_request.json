{
    "aggs": {
        "moments": {
            "aggs": {
                "annotation_hit": {
                    "top_hits": {
                        "_source": {
                            "includes": [
                                "moment_annotations"
                            ]
                        },
                        "size": 1
                    }
                },
                "total_conversation_count": {
                    "cardinality": {
                        "field": "conversation_id.keyword",
                        "precision_threshold": 40000
                    }
                },
                "total_conversation_handle_time_secs_sum": {
                    "sum": {
                      "field": "handle_time_secs"
                    }
                },
                "total_conversation_message_count": {
                    "cardinality": {
                        "precision_threshold": 40000,
                        "script": {
                            "source": "return [doc['conversation_id.keyword'] + '-' + doc['conversation_message_id.keyword']]"
                        }
                    }
                }
            },
            "filters": {
                "filters": [
                    {
                        "nested": {
                            "path": "moment_annotations",
                            "query": {
                                "bool": {
                                    "filter": [
                                        {
                                            "terms": {
                                                "moment_annotations.moment_template_id.keyword": [
                                                    "outcome"
                                                ]
                                            }
                                        },
                                        {
                                            "terms": {
                                                "moment_annotations.payload.conversationOutcome.booleanValue": [
                                                    true
                                                ]
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    {
                        "nested": {
                            "path": "moment_annotations",
                            "query": {
                                "bool": {
                                    "filter": [
                                        {
                                            "terms": {
                                                "moment_annotations.moment_template_id.keyword": [
                                                    "outcome"
                                                ]
                                            }
                                        },
                                        {
                                            "terms": {
                                                "moment_annotations.payload.conversationOutcome.booleanValue": [
                                                    false
                                                ]
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    }
                ]
            }
        },
        "total_conversation_count": {
            "cardinality": {
                "field": "conversation_id.keyword",
                "precision_threshold": 40000
            }
        },
        "total_conversation_handle_time_secs_sum": {
            "sum": {
                "field": "handle_time_secs"
            }
        },
        "total_conversation_message_count": {
            "cardinality": {
                "precision_threshold": 40000,
                "script": {
                    "source": "return [doc['conversation_id.keyword'] + '-' + doc['conversation_message_id.keyword']]"
                }
            }
        }
    },
    "query": {
        "bool": {
            "filter": [
                {
                    "range": {
                        "conversation_started_at": {
                            "gte": "2022-04-13T00:00:00Z",
                            "lt": "2022-07-13T00:00:00Z",
                            "time_zone": "+00:00"
                        }
                    }
                },
                {
                    "bool": {
                        "should": [
                            {
                                "terms": {
                                    "conversation_source": [
                                        0,
                                        7,
                                        8
                                    ]
                                }
                            },
                            {
                                "bool": {
                                    "must_not": {
                                        "exists": {
                                            "field": "conversation_source"
                                        }
                                    }
                                }
                            }
                        ]
                    }
                },
                {
                    "nested": {
                        "path": "moment_annotations",
                        "query": {
                            "bool": {
                                "filter": [
                                    {
                                        "terms": {
                                            "moment_annotations.moment_template_id.keyword": [
                                                "outcome"
                                            ]
                                        }
                                    },
                                    {
                                        "terms": {
                                            "moment_annotations.payload.conversationOutcome.booleanValue": [
                                                true,
                                                false
                                            ]
                                        }
                                    }
                                ]
                            }
                        }
                    }
                },
                {
					"terms":{
						"conversation_to_message_join":["conversation"]
					}
				},
                {
                    "range": {
                        "message_count": {
                            "gt": 0
                        }
                    }
                }
            ]
        }
    }
}
