+func (s *ConversationAssistanceUsageEvidenceCHTestSuite) readAssistanceUsageFeatureForTest(request *analyticspb.RetrieveConversationAssistanceUsageStatsRequest, population []conversationAssistanceUsagePopulationRow, feature string) ([]assistanceUsagePair, error) {
+	s.T().Helper()
+	queries, err := conversationAssistanceUsageEvidenceQueries(s.T().Context(), true /* includeBots */, request)
+	if err != nil {
+		return nil, err
+	}
+	for _, query := range queries {
+		if query.name != feature {
+			continue
+		}
+		return s.server.readConversationAssistanceUsageFeature(s.T().Context(), &shared.CustomerProfile{CustomerID: s.customerID, ProfileID: s.profileID}, population, []string{"1"}, query)
+	}
+	return nil, fmt.Errorf("missing assistance feature %s", feature)
+}
+
+func assistanceUsageQueriesForTest(t *testing.T, req *analyticspb.RetrieveConversationAssistanceUsageStatsRequest, includeBots bool) []assistanceUsageEvidenceQuery {
+	t.Helper()
+	if req == nil {
+		start := time.Date(2021, 1, 6, 7, 30, 0, 0, time.UTC)
+		req = &analyticspb.RetrieveConversationAssistanceUsageStatsRequest{FilterByTimeRange: &analyticspb.TimeRange{StartTimestamp: timestamppb.New(start), EndTimestamp: timestamppb.New(start.Add(24 * time.Hour))}}
+	}
+	queries, err := conversationAssistanceUsageEvidenceQueries(t.Context(), includeBots, req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return queries
+}
