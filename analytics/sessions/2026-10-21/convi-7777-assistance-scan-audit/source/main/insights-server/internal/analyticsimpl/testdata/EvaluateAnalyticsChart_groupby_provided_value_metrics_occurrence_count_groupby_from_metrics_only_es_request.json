{
    "query": {
        "bool": {
            "filter": [
                {
                    "terms": {
                        "conversation_to_message_join": [
                            "message"
                        ]
                    }
                },
                {
                    "terms": {
                        "conversation_source": [
                            0,
                            7,
                            8
                        ]
                    }
                },
                {
                    "bool": {
                        "filter": {
                            "bool": {
                                "should": [
                                    {
                                        "range": {
                                            "conversation_started_at": {
                                                "gte": "2024-07-01T00:00:00Z",
                                                "lt": "2024-10-01T00:00:00Z",
                                                "time_zone": "+00:00"
                                            }
                                        }
                                    }
                                ],
                                "minimum_should_match": 1
                            }
                        }
                    }
                }
            ]
        }
    },
    "aggs": {
        "bucket_aggs": {
            "filters": {
                "filters": [
                    {
                        "nested": {
                            "path": "moment_annotations",
                            "query": {
                                "bool": {
                                    "filter": [
                                        {
                                            "terms": {
                                                "moment_annotations.moment_template_id.keyword": [
                                                    "emotion-1"
                                                ]
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    {
                        "nested": {
                            "path": "moment_annotations",
                            "query": {
                                "bool": {
                                    "filter": [
                                        {
                                            "terms": {
                                                "moment_annotations.moment_template_id.keyword": [
                                                    "emotion-2"
                                                ]
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    {
                        "nested": {
                            "path": "moment_annotations",
                            "query": {
                                "bool": {
                                    "filter": [
                                        {
                                            "terms": {
                                                "moment_annotations.moment_template_id.keyword": [
                                                    "emotion-3"
                                                ]
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    {
                        "nested": {
                            "path": "moment_annotations",
                            "query": {
                                "bool": {
                                    "filter": [
                                        {
                                            "terms": {
                                                "moment_annotations.moment_template_id.keyword": [
                                                    "emotion-4"
                                                ]
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    }
                ]
            }
        }
    }
}