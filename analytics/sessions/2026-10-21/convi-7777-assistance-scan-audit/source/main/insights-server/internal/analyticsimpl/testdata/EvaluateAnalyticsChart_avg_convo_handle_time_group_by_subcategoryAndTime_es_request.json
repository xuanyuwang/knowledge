                                                                                  "type": "phrase",
                                                                                  "fields": [
                                                                                      "message_text"
                                                                                  ]
                                                                              }
                                                                          }
                                                                      ],
                                                                      "minimum_should_match": 1
                                                                  }
                                                              }
                                                          ]
                                                      }
                                                  }
                                              ],
                                              "minimum_should_match": 1
                                          }
                                      }
                                  }
                              },
                              {
