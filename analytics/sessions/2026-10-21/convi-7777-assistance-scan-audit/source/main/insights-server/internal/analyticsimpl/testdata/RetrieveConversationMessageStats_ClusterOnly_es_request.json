{
  "query":{
    "bool":{
      "filter":[
        {
          "has_parent":{
            "parent_type":"conversation",
            "query":{
              "bool":{
                "filter":[
                  {
                    "range":{
                      "conversation_started_at":{
                        "gte":"2024-07-01T00:00:00Z",
                        "lt":"2024-08-01T00:00:00Z",
                        "time_zone":"-10:00"
                      }
                    }
                  },
                  {
                    "bool":{
                      "should":[
                        {
                          "terms":{
                            "conversation_source":[
                              0,
                              7,
                              8
                            ]
                          }
                        },
                        {
                          "bool":{
                            "must_not":{
                              "exists":{
                                "field":"conversation_source"
                              }
                            }
                          }
                        }
                      ]
                    }
                  },
                  {
                    "bool":{
                      "should":[
                        {
                          "has_child":{
                            "type":"message_group",
                            "query":{
                              "bool":{
                                "filter":[
                                  {
                                    "bool":{
                                      "minimum_should_match":1,
                                      "should":[
                                        {
                                          "nested":{
                                            "path":"moment_annotations",
                                            "query":{
                                              "bool":{
                                                "filter":[
                                                  {
                                                    "terms":{
                                                      "moment_annotations.moment_template_id.keyword":[
                                                        "cluster-moment-1"
                                                      ]
                                                    }
                                                  }
                                                ]
                                              }
                                            }
                                          }
                                        }
                                      ],
                                      "filter":[
                                        {
                                          "nested":{
                                            "path":"moment_annotations",
                                            "query":{
                                              "bool":{
                                                "filter":[
                                                  {
                                                    "terms":{
                                                      "moment_annotations.moment_template_id.keyword":[
                                                        "pretopic-moment-1"
                                                      ]
                                                    }
                                                  }
                                                ]
                                              }
                                            }
                                          }
                                        }
                                      ]
                                    }
                                  },
                                  {
                                    "terms":{
                                      "speaker_role":[
                                        "visitor"
                                      ]
                                    }
                                  }
                                ]
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    }
  },
  "aggs":{
    "total_conversation_count":{
      "cardinality":{
        "field":"conversation_id.keyword",
        "precision_threshold":40000
      }
    },
    "total_conversation_handle_time_secs_sum": {
      "sum": {
        "field": "handle_time_secs"
      }
    },
    "total_conversation_message_count":{
      "cardinality":{
        "script":{
          "source":"return [doc['conversation_id.keyword'] + '-' + doc['conversation_message_id.keyword']]"
        },
        "precision_threshold":40000
      }
    },
    "time_ranges":{
      "date_histogram":{
        "field":"conversation_started_at",
        "time_zone":"-10:00",
        "calendar_interval":"day"
      },
      "aggs":{
        "total_conversation_count":{
          "cardinality":{
            "field":"conversation_id.keyword",
            "precision_threshold":40000
          }
        },
        "total_conversation_handle_time_secs_sum": {
          "sum": {
            "field": "handle_time_secs"
          }
        },
        "total_conversation_message_count":{
          "cardinality":{
            "script":{
              "source":"return [doc['conversation_id.keyword'] + '-' + doc['conversation_message_id.keyword']]"
            },
            "precision_threshold":40000
          }
        }
      }
    }
  }
}