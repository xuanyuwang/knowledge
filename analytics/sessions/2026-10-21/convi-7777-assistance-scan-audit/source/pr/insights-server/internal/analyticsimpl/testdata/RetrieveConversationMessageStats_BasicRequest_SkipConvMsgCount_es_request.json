{
  "aggs": {
    "moments": {
      "aggs": {
        "annotation_hit": {
          "top_hits": {
            "_source": {
              "includes": [
                "moment_annotations"
              ]
            },
            "size": 1
          }
        },
        "total_conversation_handle_time_secs_sum": {
          "sum": {
            "field": "handle_time_secs"
          }
        },
        "total_conversation_count": {
          "cardinality": {
            "field": "conversation_id.keyword",
            "precision_threshold": 40000
          }
        }
      },
      "filters": {
        "filters": [
          {
            "nested": {
              "path": "moment_annotations",
              "query": {
                "bool": {
                  "filter": [
                    {
                      "terms": {
                        "moment_annotations.moment_template_id.keyword": [
                          "f0a590e0-ccc7-4981-9634-4cfaf67c782c"
                        ]
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "nested": {
              "path": "moment_annotations",
              "query": {
                "bool": {
                  "filter": [
                    {
                      "terms": {
                        "moment_annotations.moment_template_id.keyword": [
                          "f0a590e0-ccc7-4981-9634-4cfaf67c782c"
                        ]
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "total_conversation_count": {
      "cardinality": {
        "field": "conversation_id.keyword",
        "precision_threshold": 40000
      }
    },
    "total_conversation_handle_time_secs_sum": {
      "sum": {
        "field": "handle_time_secs"
      }
    }
  },
  "query": {
    "bool": {
      "filter": [
