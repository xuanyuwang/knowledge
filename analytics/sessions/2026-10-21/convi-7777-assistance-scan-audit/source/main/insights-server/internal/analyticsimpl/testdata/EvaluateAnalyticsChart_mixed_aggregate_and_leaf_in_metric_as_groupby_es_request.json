{
    "query": {
        "bool": {
            "filter": [
                {
                    "terms": {
                        "conversation_to_message_join": [
                            "conversation"
                        ]
                    }
                },
                {
                    "terms": {
                        "conversation_source": [
                            0,
                            7,
                            8
                        ]
                    }
                },
                {
                    "range": {
                        "message_count": {
                            "gt": 0
                        }
                    }
                }
            ]
        }
    },
    "aggs": {
        "bucket_aggs": {
            "filters": {
                "filters": [
                    {
                        "has_child": {
                            "type": "message",
                            "query": {
                                "bool": {
                                    "should": [
                                        {
                                            "bool": {
                                                "minimum_should_match": 1,
                                                "should": [
                                                    {
                                                        "bool": {
                                                            "filter": [
                                                                {
                                                                    "terms": {
                                                                        "conversation_to_message_join": [
                                                                            "message"
                                                                        ]
                                                                    }
                                                                }
                                                            ],
                                                            "should": [
                                                                {
                                                                    "multi_match": {
                                                                        "query": "leaf_keyword_1",
                                                                        "type": "phrase",
                                                                        "fields": [
                                                                            "message_text"
                                                                        ]
                                                                    }
                                                                }
                                                            ],
                                                            "minimum_should_match": 1
                                                        }
                                                    }
                                                ]
                                            }
                                        }
                                    ],
                                    "minimum_should_match": 1
                                }
                            }
                        }
                    },
                    {
                        "has_child": {
                            "type": "message",
                            "query": {
                                "bool": {
                                    "should": [
                                        {
                                            "bool": {
                                                "minimum_should_match": 1,
                                                "should": [
                                                    {
                                                        "bool": {
                                                            "filter": [
                                                                {
                                                                    "terms": {
                                                                        "conversation_to_message_join": [
                                                                            "message"
                                                                        ]
                                                                    }
                                                                }
                                                            ],
                                                            "should": [
                                                                {
                                                                    "multi_match": {
                                                                        "query": "agg_keyword_1",
                                                                        "type": "phrase",
                                                                        "fields": [
                                                                            "message_text"
                                                                        ]
                                                                    }
                                                                }
                                                            ],
                                                            "minimum_should_match": 1
                                                        }
                                                    }
                                                ]
                                            }
                                        }
                                    ],
                                    "minimum_should_match": 1
                                }
                            }
                        }
                    }
                ]
            },
            "aggs": {
                "bucket_aggs": {
                    "date_histogram": {
                        "field": "conversation_started_at",
                        "time_zone": "+00:00",
                        "calendar_interval": "day",
                        "min_doc_count": 0
                    }
                }
            }
        }
    }
}
