                                                                                "filter": [
                                                                                    {
                                                                                        "terms": {
                                                                                            "conversation_to_message_join": [
                                                                                                "message"
                                                                                            ]
                                                                                        }
                                                                                    }
                                                                                ],
                                                                                "should": [
                                                                                    {
                                                                                        "multi_match": {
                                                                                            "query": "keyword1",
                                                                                            "type": "phrase",
                                                                                            "fields": [
                                                                                                "message_text"
                                                                                            ]
                                                                                        }
                                                                                    }
                                                                                ],
                                                                                "minimum_should_match": 1
                                                                            }
                                                                        }
                                                                    ]
                                                                }
                                                            }
                                                        ],
                                                        "minimum_should_match": 1
                                                    }
                                                }
                                            }
                                        }
                                    ]
                                }
                            },
                            {
                                "bool": {
                                    "filter": [
                                        {
                                            "has_child": {
                                                "type": "message",
                                                "query": {
                                                    "bool": {
                                                        "should": [
                                                            {
                                                                "bool": {
                                                                    "minimum_should_match": 1,
                                                                    "should": [
                                                                        {
                                                                            "bool": {
                                                                                "filter": [
                                                                                    {
                                                                                        "terms": {
                                                                                            "conversation_to_message_join": [
                                                                                                "message"
                                                                                            ]
                                                                                        }
                                                                                    }
                                                                                ],
                                                                                "should": [
                                                                                    {
                                                                                        "multi_match": {
