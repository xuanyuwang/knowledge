{
  "query": {
    "bool": {
      "filter": [
        {
          "terms": {
            "conversation_to_message_join": [
              "conversation"
            ]
          }
        },
        {
          "terms": {
            "conversation_source": [
              0,
              7,
              8
            ]
          }
        },
        {
          "range": {
            "message_count": {
              "gt": 0
            }
          }
        },
        {
          "bool": {
            "filter": {
              "bool": {
                "should": [
                  {
                    "range": {
                      "conversation_started_at": {
                        "gte": "2024-07-01T00:00:00Z",
                        "lt": "2024-10-01T00:00:00Z",
                        "time_zone": "+00:00"
                      }
                    }
                  }
                ],
                "minimum_should_match": 1
              }
            }
          }
        },
        {
          "bool": {
            "filter": {
              "bool": {
                "should": [
                  {
                    "has_child": {
                      "type": "message",
                      "query": {
                        "bool": {
                          "filter": [
                            {
                              "nested": {
                                "path": "moment_annotations",
                                "query": {
                                  "bool": {
                                    "filter": [
                                      {
                                        "terms": {
                                          "moment_annotations.moment_template_id.keyword": [
                                            "tdv3-cat-1",
                                            "tdv3-cat-1-1",
                                            "tdv3-cat-1-2",
                                            "tdv3-cat-1-2-1"
                                          ]
                                        }
                                      }
                                    ]
                                  }
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  }
                ],
                "minimum_should_match": 1
              }
            }
          }
        },
        {
          "bool": {
            "filter": {
              "bool": {
                "should": [
                  {
                    "has_child": {
                      "type": "message",
                      "query": {
                        "bool": {
                          "filter": [
                            {
                              "nested": {
                                "path": "moment_annotations",
                                "query": {
                                  "bool": {
                                    "filter": [
                                      {
                                        "terms": {
                                          "moment_annotations.moment_template_id.keyword": [
                                            "emotion-1"
                                          ]
                                        }
                                      }
                                    ]
                                  }
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  }
                ],
                "minimum_should_match": 1
              }
            }
          }
        }
      ]
    }
  },
  "aggs": {
    "metrics_conversation_count": {
      "cardinality": {
        "field": "conversation_id.keyword",
        "precision_threshold": 40000
      }
    }
  }
}