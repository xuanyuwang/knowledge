{
   "highlight": {
      "fields":{
         "message_text":{
            "number_of_fragments":0
         },
         "message_text_whitespace":{
            "number_of_fragments":0
         },
         "message_text_with_custom_analyzer.english":{
            "number_of_fragments":0
         },
         "message_text_with_custom_analyzer.spanish":{
            "number_of_fragments":0
         },
         "message_text_with_custom_analyzer.french":{
            "number_of_fragments":0
         },
         "message_text_with_custom_analyzer.italian":{
            "number_of_fragments":0
         },
         "message_text_with_custom_analyzer.german":{
            "number_of_fragments":0
         },
         "message_text_with_custom_analyzer.dutch":{
            "number_of_fragments":0
         },
         "message_text_with_custom_analyzer.portuguese":{
            "number_of_fragments":0
         },
         "message_text_with_custom_analyzer.russian":{
            "number_of_fragments":0
         },
         "message_text_with_custom_analyzer.thai":{
            "number_of_fragments":0
         }
      },
      "post_tags": [
         "\u003c/mark\u003e"
      ],
      "pre_tags": [
         "\u003cmark\u003e"
      ]
   },
   "query": {
      "bool": {
         "filter": [
            {
               "has_parent": {
                  "parent_type": "conversation",
                  "query": {
                     "bool": {
                        "filter": [
                           {
                              "range": {
                                 "conversation_started_at": {
                                    "gte": "2022-04-13T00:00:00Z",
                                    "lt": "2022-07-13T00:00:00Z",
                                    "time_zone": "-10:00"
                                 }
                              }
                           },
                           {
                              "bool": {
                                 "should": [
                                    {
                                       "terms": {
                                          "conversation_source": [
                                             0,
                                             7,
                                             8
                                          ]
                                       }
                                    },
                                    {
                                       "bool": {
                                          "must_not": {
                                             "exists": {
                                                "field": "conversation_source"
                                             }
                                          }
                                       }
                                    }
                                 ]
                              }
                           },
                           {
                              "terms": {
                                 "agent_user_id.keyword": [
                                    "user-id1"
                                 ]
                              }
                           },
                           {
                              "bool": {
                                 "should": [
                                    {
                                       "bool": {
                                          "should": [
                                             {
                                                "has_child": {
                                                   "type": "message",
                                                   "query": {
                                                      "bool": {
                                                         "filter": [
                                                            {
                                                               "nested": {
                                                                  "path": "action_annotations",
                                                                  "query": {
                                                                     "bool": {
                                                                        "filter": [
                                                                           {
                                                                              "terms": {
                                                                                 "action_annotations.action_id.keyword": [
                                                                                    "convo-action-1"
                                                                                 ]
                                                                              }
                                                                           }
                                                                        ]
                                                                     }
                                                                  }
                                                               }
                                                            }
                                                         ]
                                                      }
                                                   }
                                                }
                                             }
                                          ],
                                          "minimum_should_match": 1
                                       }
                                    },
                                    {
                                       "bool": {
                                          "should": [
                                             {
                                                "has_child": {
                                                   "type": "message",
                                                   "query": {
                                                      "bool": {
                                                         "filter": [
                                                            {
                                                               "nested": {
                                                                  "path": "action_annotations",
                                                                  "query": {
                                                                     "bool": {
                                                                        "filter": [
                                                                           {
                                                                              "terms": {
                                                                                 "action_annotations.action_id.keyword": [
                                                                                    "convo-action-2"
                                                                                 ]
                                                                              }
                                                                           }
                                                                        ]
                                                                     }
                                                                  }
                                                               }
                                                            }
                                                         ]
                                                      }
                                                   }
                                                }
                                             }
                                          ],
                                          "minimum_should_match": 1
                                       }
                                    }
                                 ],
                                 "minimum_should_match": 1
                              }
                           }
                        ]
                     }
                  }
               }
            },
            {
               "nested": {
                  "path": "moment_annotations",
                  "query": {
                     "bool": {
                        "filter": [
                           {
                              "terms": {
                                 "moment_annotations.adherence_action_id.keyword": [
                                    "msg-action-1"
                                 ]
                              }
                           },
                           {
                              "terms": {
                                 "moment_annotations.adherence_type": [
                                    2
                                 ]
                              }
                           }
                        ]
                     }
                  }
               }
            }
         ]
      }
   },
   "sort": [
      {
         "conversation_ended_at": {
            "format": "strict_date_optional_time_nanos",
            "order": "desc"
         }
      },
      {
         "created_at": {
         "format": "strict_date_optional_time_nanos",
         "order": "asc"
         }
      }
   ]
}
