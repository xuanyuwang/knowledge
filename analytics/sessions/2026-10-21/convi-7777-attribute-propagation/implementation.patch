+func (s *ConversationAssistanceUsageEvidenceCHTestSuite) TestFeatureAttributeFilters() {
+	for _, feature := range []string{"KB search", "Chat Suggestions", "GenAI", "Summary", "Hints", "Notes", "Guided Workflow"} {
+		for _, filter := range []string{"Language", "Usecase", "Duration", "Voicemail", "Combined"} {
+			s.Run(feature+"_"+filter, func() {
+				// Given
+				start := time.Date(2021, 9, 1, 0, 0, 0, 0, time.UTC)
+				attribute := &analyticspb.Attribute{}
+				if filter == "Language" || filter == "Combined" {
+					attribute.LanguageCodes = []string{"en-US"}
+				}
+				if filter == "Usecase" || filter == "Combined" {
+					attribute.UsecaseNames = []string{s.profileResourceName + "/usecases/sales"}
+				}
+				if filter == "Duration" || filter == "Combined" {
+					attribute.ConversationDurationRange = &analyticspb.DurationRange{MinDuration: durationpb.New(60 * time.Second)}
+				}
+				if filter == "Voicemail" || filter == "Combined" {
+					attribute.ConversationCriterions = []analyticspb.ConversationCriterion{analyticspb.ConversationCriterion_EXCLUDE_VOICE_MAIL}
+				}
+				matching := s.seedAssistanceUsageAttributeFeature(feature, start, true /* matches */)
+				nonmatching := s.seedAssistanceUsageAttributeFeature(feature, start, false /* matches */)
+				population := []conversationAssistanceUsagePopulationRow{matching, nonmatching}
+				request := &analyticspb.RetrieveConversationAssistanceUsageStatsRequest{Parent: s.profileResourceName, FilterByTimeRange: &analyticspb.TimeRange{StartTimestamp: timestamppb.New(start), EndTimestamp: timestamppb.New(start.Add(time.Hour))}, FilterByAttribute: attribute}
+
+				// When
+				pairs, err := s.readAssistanceUsageFeatureForTest(request, population, feature)
+
+				// Then
+				s.Require().NoError(err)
+				s.Equal([]assistanceUsagePair{{matching.conversationID, "1"}}, pairs)
+			})
+		}
+	}
+}
