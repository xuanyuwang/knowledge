{
    "query": {
        "bool": {
            "filter": [
                {
                    "terms": {
                        "conversation_to_message_join": [
                            "conversation"
                        ]
                    }
                },
                {
                    "terms": {
                        "conversation_source": [
                            0,
                            7,
                            8
                        ]
                    }
                },
                {
                    "range": {
                        "message_count": {
                            "gt": 0
                        }
                    }
                },
                {
                    "bool": {
                        "filter": {
                            "bool": {
                                "should": [
                                    {
                                        "range": {
                                            "conversation_started_at": {
                                                "gte": "2024-07-01T00:00:00Z",
                                                "lt": "2024-11-15T00:00:00Z",
                                                "time_zone": "+00:00"
                                            }
                                        }
                                    }
                                ],
                                "minimum_should_match": 1
                            }
                        }
                    }
                }
            ]
        }
    },
    "aggs": {
        "bucket_aggs": {
            "nested": {
                "path": "scorecards"
            },
            "aggs": {
                "bucket_aggs": {
                    "nested": {
                        "path": "scorecards.scorecard_scores"
                    },
                    "aggs": {
                        "bucket_aggs": {
                            "filters": {
                                "filters": [
                                    {
                                        "terms": {
                                            "scorecards.scorecard_scores.criterion_id.keyword": [
                                                "test-criterion-id1"
                                            ]
                                        }
                                    },
                                    {
                                        "terms": {
                                            "scorecards.scorecard_scores.criterion_id.keyword": [
                                                "test-criterion-id2"
                                            ]
                                        }
                                    }
                                ]
                            },
                            "aggs": {
                                "metrics_agg_on_numeric_field": {
                                    "avg": {
                                        "field": "scorecards.scorecard_scores.percentage_score"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}