                "filter": [
                  {
                    "range": {
                      "conversation_started_at": {
                        "gte": "2022-04-13T00:00:00Z",
                        "lt": "2022-07-13T00:00:00Z",
                        "time_zone": "-10:00"
                      }
                    }
                  },
                  {
                    "bool": {
                      "should": [
                        {
                          "terms": {
                            "conversation_source": [
                              0,
                              7,
                              8
                            ]
                          }
                        },
                        {
                          "bool": {
                            "must_not": {
                              "exists": {
                                "field": "conversation_source"
                              }
                            }
                          }
                        }
                      ]
                    }
                  },
                  {
                    "has_child": {
                      "type": "message",
                      "query": {
                        "bool": {
                          "filter": [
                            {
                              "terms": {
                                "speaker_role": [
                                  "agent",
                                  "visitor"
                                ]
                              }
                            }
                          ],
                          "should": [
                            {
                              "multi_match": {
                                "query": "internet promotion",
                                "type": "phrase",
                                "fields": [
                                  "message_text_with_lang.pt-PT",
                                  "message_text_with_lang.sv-SE",
                                  "message_text_with_lang.de-DE",
                                  "message_text_with_lang.en-NZ",
                                  "message_text_with_lang.fr-CA",
                                  "message_text_with_lang.fr-FR",
                                  "message_text_with_lang.en-GB",
                                  "message_text_with_lang.en-US",
                                  "message_text_with_lang.es-419",
                                  "message_text_with_lang.es-ES",
                                  "message_text_with_lang.nl-NL",
                                  "message_text_with_lang.pt-BR",
                                  "message_text_with_lang.en-AU",
                                  "message_text_with_lang.it-IT"
                                ]
                              }
                            },
                            {
                              "multi_match": {
                                "query": "discount",
                                "type": "phrase",
                                "fields": [
                                  "message_text_with_lang.pt-PT",
                                  "message_text_with_lang.sv-SE",
                                  "message_text_with_lang.de-DE",
                                  "message_text_with_lang.en-NZ",
                                  "message_text_with_lang.fr-CA",
                                  "message_text_with_lang.fr-FR",
                                  "message_text_with_lang.en-GB",
                                  "message_text_with_lang.en-US",
                                  "message_text_with_lang.es-419",
                                  "message_text_with_lang.es-ES",
                                  "message_text_with_lang.nl-NL",
                                  "message_text_with_lang.pt-BR",
                                  "message_text_with_lang.en-AU",
                                  "message_text_with_lang.it-IT"
                                ]
                              }
                            }
                          ],
                          "minimum_should_match": 1
                        }
                      }
                    }
                  }
                ],
                "must_not": [
                  {
                    "nested": {
                      "path": "moment_annotations",
