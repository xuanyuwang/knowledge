{
  "query": {
      "bool": {
          "filter": [
              {
                  "terms": {
                      "conversation_to_message_join": [
                          "conversation"
                      ]
                  }
              },
              {
                  "terms": {
                      "conversation_source": [
                          0,
                          7,
                          8
                      ]
                  }
              },
              {
                  "range": {
                      "message_count": {
                          "gt": 0
                      }
                  }
              },
              {
                  "bool": {
                      "filter": {
                          "bool": {
                              "should": [
                                  {
                                      "range": {
                                          "conversation_started_at": {
                                              "gte": "2024-07-01T00:00:00Z",
                                              "lt": "2024-10-01T00:00:00Z",
                                              "time_zone": "+00:00"
                                          }
                                      }
                                  }
                              ],
                              "minimum_should_match": 1
                          }
                      }
                  }
              }
          ]
      }
  },
