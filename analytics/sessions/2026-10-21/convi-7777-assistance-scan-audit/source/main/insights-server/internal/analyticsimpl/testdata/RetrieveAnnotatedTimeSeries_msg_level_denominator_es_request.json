{
  "query": {
    "bool": {
      "filter": [
        {
          "range": {
            "conversation_started_at": {
              "gte": "2025-12-24T10:00:00Z",
              "lt": "2026-03-25T10:00:00Z",
              "time_zone": "-10:00"
            }
          }
        },
        {
          "bool": {
            "should": [
              {
                "terms": {
                  "conversation_source": [
                    0,
                    7,
                    8
                  ]
                }
              },
              {
                "bool": {
                  "must_not": {
                    "exists": {
                      "field": "conversation_source"
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "terms": {
            "usecase_id.keyword": [
              "initial"
            ]
          }
        },
        {
          "terms": {
            "conversation_to_message_join": [
              "conversation"
            ]
          }
        },
        {
          "range": {
            "message_count": {
              "gt": 0
            }
          }
        }
      ]
    }
  },
  "aggs": {
    "time_ranges": {
      "date_histogram": {
        "field": "conversation_started_at",
        "time_zone": "-10:00",
        "calendar_interval": "day"
      },
      "aggs": {}
    }
  }
}
