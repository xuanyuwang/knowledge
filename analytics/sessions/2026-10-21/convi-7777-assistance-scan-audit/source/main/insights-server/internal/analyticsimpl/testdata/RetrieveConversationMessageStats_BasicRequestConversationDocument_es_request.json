{
  "query": {
    "bool": {
      "filter": [
        {
          "range": {
            "conversation_started_at": {
              "gte": "2022-04-13T00:00:00Z",
              "lt": "2022-07-13T00:00:00Z",
              "time_zone": "-10:00"
            }
          }
        },
        {
          "bool": {
            "should": [
              {
                "terms": {
                  "conversation_source": [
                    0,
                    7,
                    8
                  ]
                }
              },
              {
                "bool": {
                  "must_not": {
                    "exists": {
                      "field": "conversation_source"
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "terms": {
            "conversation_to_message_join": [
              "conversation"
            ]
          }
        },
        {
          "range": {
            "message_count": {
              "gt": 0
            }
          }
        }
      ],
      "must_not": [
        {
          "nested": {
            "path": "moment_annotations",
            "query": {
              "bool": {
                "filter": [
                  {
                    "terms": {
                      "moment_annotations.moment_template_id.keyword": [
                        "sentiment-moment-1",
                        "sentiment-moment-2"
                      ]
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    }
  },
  "aggs": {
    "total_conversation_count": {
      "cardinality": {
        "field": "conversation_id.keyword",
        "precision_threshold": 40000
      }
    },
    "total_conversation_message_count": {
      "cardinality": {
        "script": {
          "source": "return [doc['conversation_id.keyword'] + '-' + doc['conversation_message_id.keyword']]"
        },
        "precision_threshold": 40000
      }
    },
    "total_conversation_handle_time_secs_sum": {
      "sum": {
        "field": "handle_time_secs"
      }
    },
    "moments": {
      "filters": {
        "filters": [
          {
            "has_child": {
              "type": "message_group",
              "query": {
                "bool": {
                  "filter": [
                    {
                      "nested": {
                        "path": "moment_annotations",
                        "query": {
                          "bool": {
                            "filter": [
                              {
                                "terms": {
                                  "moment_annotations.moment_template_id.keyword": [
                                    "f0a590e0-ccc7-4981-9634-4cfaf67c782c"
                                  ]
                                }
                              }
                            ]
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "has_child": {
              "type": "message_group",
              "query": {
                "bool": {
                  "filter": [
                    {
                      "nested": {
                        "path": "moment_annotations",
                        "query": {
                          "bool": {
                            "filter": [
                              {
                                "terms": {
                                  "moment_annotations.moment_template_id.keyword": [
                                    "f0a590e0-ccc7-4981-9634-4cfaf67c782c"
                                  ]
                                }
                              }
                            ]
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      },
      "aggs": {
        "total_conversation_count": {
          "cardinality": {
            "field": "conversation_id.keyword",
            "precision_threshold": 40000
          }
        },
        "total_conversation_message_count": {
          "cardinality": {
            "script": {
              "source": "return [doc['conversation_id.keyword'] + '-' + doc['conversation_message_id.keyword']]"
            },
            "precision_threshold": 40000
          }
        },
        "total_conversation_handle_time_secs_sum": {
          "sum": {
            "field": "handle_time_secs"
          }
        },
        "annotation_hit": {
          "top_hits": {
            "size": 1,
            "_source": {
              "includes": [
                "moment_annotations"
              ]
            }
          }
        }
      }
    }
  }
}
