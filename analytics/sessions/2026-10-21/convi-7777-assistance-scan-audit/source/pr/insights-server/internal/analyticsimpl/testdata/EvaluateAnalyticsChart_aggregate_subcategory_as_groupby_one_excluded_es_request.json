{
    "query": {
        "bool": {
            "filter": [
                {
                    "terms": {
                        "conversation_to_message_join": [
                            "conversation"
                        ]
                    }
                },
                {
                    "terms": {
                        "conversation_source": [
                            0,
                            7,
                            8
                        ]
                    }
                },
                {
                    "range": {
                        "message_count": {
                            "gt": 0
                        }
                    }
                }
            ]
        }
    },
    "aggs": {
        "bucket_aggs": {
            "filters": {
                "filters": [
                    {
                        "bool": {
                            "must_not": [
                                {
                                    "bool": {
                                        "should": [
                                            {
                                                "has_child": {
                                                    "type": "message",
                                                    "query": {
                                                        "bool": {
                                                            "should": [
                                                                {
                                                                    "bool": {
                                                                        "must_not": [
                                                                            {
                                                                                "bool": {
                                                                                    "should": [
                                                                                        {
                                                                                            "multi_match": {
                                                                                                "query": "moment_1_keyword_excluded_1",
                                                                                                "type": "phrase",
                                                                                                "fields": [
                                                                                                    "message_text"
                                                                                                ]
                                                                                            }
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            }
                                                                        ],
                                                                        "minimum_should_match": 1,
                                                                        "should": [
                                                                            {
                                                                                "bool": {
                                                                                    "filter": [
                                                                                        {
                                                                                            "terms": {
                                                                                                "conversation_to_message_join": [
                                                                                                    "message"
                                                                                                ]
                                                                                            }
                                                                                        }
                                                                                    ],
                                                                                    "should": [
                                                                                        {
                                                                                            "multi_match": {
                                                                                                "query": "moment_1_keyword_included_1",
                                                                                                "type": "phrase",
                                                                                                "fields": [
                                                                                                    "message_text"
                                                                                                ]
                                                                                            }
                                                                                        }
                                                                                    ],
                                                                                    "minimum_should_match": 1
                                                                                }
                                                                            }
                                                                        ]
                                                                    }
                                                                }
                                                            ],
                                                            "minimum_should_match": 1
                                                        }
                                                    }
                                                }
                                            },
                                            {
                                                "has_child": {
                                                    "type": "message_group",
                                                    "query": {
                                                        "bool": {
                                                            "should": [
                                                                {
                                                                    "bool": {
                                                                        "must_not": [
                                                                            {
                                                                                "bool": {
                                                                                    "should": [
                                                                                        {
                                                                                            "multi_match": {
                                                                                                "query": "moment_1_keyword_excluded_1",
                                                                                                "type": "phrase",
                                                                                                "fields": [
                                                                                                    "message_text"
                                                                                                ]
                                                                                            }
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            }
                                                                        ],
                                                                        "minimum_should_match": 1,
                                                                        "should": [
                                                                            {
                                                                                "nested": {
                                                                                    "path": "moment_annotations",
                                                                                    "query": {
                                                                                        "bool": {
                                                                                            "filter": [
                                                                                                {
                                                                                                    "terms": {
                                                                                                        "moment_annotations.moment_template_id.keyword": [
                                                                                                            "moment_1_cluster_1"
                                                                                                        ]
                                                                                                    }
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        ]
                                                                    }
                                                                }
                                                            ],
                                                            "minimum_should_match": 1
                                                        }
                                                    }
                                                }
                                            }
                                        ],
                                        "minimum_should_match": 1
                                    }
                                }
                            ]
                        }
                    }
                ]
            },
            "aggs": {
                "bucket_aggs": {
                    "date_histogram": {
                        "field": "conversation_started_at",
                        "time_zone": "+00:00",
                        "calendar_interval": "day",
                        "min_doc_count": 0
                    }
                }
            }
        }
    }
}
