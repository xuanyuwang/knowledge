  "scenarios": [
    {
      "name": "BehavioralDeliveryModesAndDuplicateAnnotations",
      "expected_behavior": "Two positive annotations for one delivered action plus one positive annotation without a delivery count sent/followed 2/2 in moment mode, 1/2 in action mode; empty IDs and unsupported adherence are excluded.",
      "evidence": "TestHintStatsUsageIntegration/TestBehavioralDeliveryModesAndDuplicateAnnotations"
    },
    {
      "name": "DeliveredRowsOwnAgentAndTimeAttribution",
      "expected_behavior": "A recipient action and detector annotation yield recipient sent=1/followed=0 in action mode; annotation-only detector group is absent.",
      "evidence": "TestHintStatsUsageIntegration/TestDeliveredRowsOwnAgentAndTimeAttribution"
    },
    {
      "name": "SourcesDevelopmentUsersAndPolicyGates",
      "expected_behavior": "Only source0 and optional bot7, policy-source1, non-dev, nonempty-agent supported actions count; checklist21 without adherence does not enter the nonbehavior branch.",
      "evidence": "TestHintStatsUsageIntegration/TestSourcesDevelopmentUsersAndPolicyGates"
    },
    {
      "name": "MomentAndEventEligibilityGuards",
      "expected_behavior": "With profile bot inclusion, sources0/8/7 survive all three tables; dev users, empty agents, source9 and policy-source2 do not. Sent=3, followed=6 in both action modes.",
      "evidence": "TestHintStatsUsageIntegration/TestMomentAndEventEligibilityGuards"
    },
    {
      "name": "KnowledgeFollowsAreDistinctActionsIncludingMissingID",
      "expected_behavior": "Actions1/6/13/14 contribute sent=4; event9 counts distinct action IDs, including empty and unlinked IDs, so repeated event IDs across one action count once and followed=3.",
      "evidence": "TestHintStatsUsageIntegration/TestKnowledgeFollowsAreDistinctActionsIncludingMissingID"
    },
    {
      "name": "MixedBranchesRetainMaximumDenominators",
      "expected_behavior": "Behavioral population2 conversations/2 agents and nonbehavioral3 conversations/1 agent produce sent=3, conversations=3, users=2, followed=2; a conversation_d row without hints contributes nothing.",
      "evidence": "TestHintStatsUsageIntegration/TestMixedBranchesRetainMaximumDenominators"
    },
    {
      "name": "SameConversationCountsForEachAgent",
      "expected_behavior": "One conversation with two agent-specific actions produces two groups and response conversation total2.",
      "evidence": "TestHintStatsUsageIntegration/TestSameConversationCountsForEachAgent"
    },
    {
      "name": "UserFilterInlineAndExternalForBothDeliveryModes",
      "expected_behavior": "Selected user survives both inline and external filters in both action modes, across all three tables. Sent=1/followed=2; excluded user is absent.",
      "evidence": "TestHintStatsUsageIntegration/TestUserFilterInlineAndExternalForBothDeliveryModes"
    },
    {
      "name": "ConversationStartBoundsAndTimezoneBuckets",
      "expected_behavior": "Conversation start uses an inclusive start and exclusive end, independent of create time. Honolulu splits three included actions into Dec31 10UTC count1 and Jan1 10UTC count2.",
      "evidence": "TestHintStatsUsageIntegration/TestConversationStartBoundsAndTimezoneBuckets"
    },
    {
      "name": "NoFrequencyKeepsTotalsAndRemovesBuckets",
      "expected_behavior": "No frequency with agent grouping preserves all totals/rates and returns no HintStats buckets.",
      "evidence": "TestHintStatsUsageIntegration/TestNoFrequencyKeepsTotalsAndRemovesBuckets"
    },
    {
      "name": "BehaviorGroupingAndFilterUseMomentRows",
      "expected_behavior": "Behavior grouping/filter returns the moment-owned behavior in default mode; action mode returns empty because actions lack behavior and their parser condition is false.",
      "evidence": "TestHintStatsUsageIntegration/TestBehaviorGroupingAndFilterUseMomentRows"
    },
    {
      "name": "PolicyGroupingRetainsSourceColumnMapping",
      "expected_behavior": "Policy filter/grouping resolves policy_id on actions and action_policy_id on conversation events to the same response policy; sent=1/followed=1.",
      "evidence": "TestHintStatsUsageIntegration/TestPolicyGroupingRetainsSourceColumnMapping"
