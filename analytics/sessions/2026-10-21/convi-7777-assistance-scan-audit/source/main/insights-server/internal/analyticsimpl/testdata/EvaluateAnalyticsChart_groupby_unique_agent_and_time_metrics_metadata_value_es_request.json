{
    "query": {
        "bool": {
            "filter": [
                {
                    "terms": {
                        "conversation_to_message_join": [
                            "conversation"
                        ]
                    }
                },
                {
                    "terms": {
                        "conversation_source": [
                            0,
                            7,
                            8
                        ]
                    }
                },
                {
                    "range": {
                        "message_count": {
                            "gt": 0
                        }
                    }
                },
                {
                    "bool": {
                        "filter": {
                            "bool": {
                                "should": [
                                    {
                                        "range": {
                                            "conversation_started_at": {
                                                "gte": "2024-07-01T00:00:00Z",
                                                "lt": "2024-08-15T00:00:00Z",
                                                "time_zone": "+00:00"
                                            }
                                        }
                                    }
                                ],
                                "minimum_should_match": 1
                            }
                        }
                    }
                },
                {
                    "bool": {
                        "filter": {
                            "bool": {
                                "should": [
                                    {
                                        "nested": {
                                            "path": "moment_annotations",
                                            "query": {
                                                "bool": {
                                                    "filter": [
                                                        {
                                                            "terms": {
                                                                "moment_annotations.moment_template_id.keyword": [
                                                                    "metadata-1"
                                                                ]
                                                            }
                                                        }
                                                    ]
                                                }
                                            }
                                        }
                                    }
                                ],
                                "minimum_should_match": 1
                            }
                        }
                    }
                }
            ]
        }
    },
    "aggs": {
        "bucket_aggs": {
            "terms": {
                "field": "agent_user_id.keyword",
                "size": 1000,
                "order": {
                    "bucket_aggs_for_order_by_metrics\u003ebucket_aggs\u003emetrics_agg_on_numeric_field": "desc"
                }
            },
            "aggs": {
                "bucket_aggs": {
                    "date_histogram": {
                        "field": "conversation_started_at",
                        "time_zone": "+00:00",
                        "calendar_interval": "month",
                        "min_doc_count": 0,
                        "extended_bounds": {
                            "min": "2024-07-01T00:00:00Z",
                            "max": "2024-08-15T00:00:00Z"
                        }
                    },
                    "aggs": {
                        "bucket_aggs": {
                            "nested": {
                                "path": "moment_annotations"
                            },
                            "aggs": {
                                "bucket_aggs": {
                                    "filter": {
                                        "terms": {
                                            "moment_annotations.moment_template_id.keyword": [
                                                "metadata-1"
                                            ]
                                        }
                                    },
                                    "aggs": {
                                        "metrics_agg_on_numeric_field": {
                                            "avg": {
                                                "field": "moment_annotations.payload_with_explicit_mapping.metadata_number_value"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "bucket_aggs_for_order_by_metrics": {
                    "nested": {
                        "path": "moment_annotations"
                    },
                    "aggs": {
                        "bucket_aggs": {
                            "filter": {
                                "terms": {
                                    "moment_annotations.moment_template_id.keyword": [
                                        "metadata-1"
                                    ]
                                }
                            },
                            "aggs": {
                                "metrics_agg_on_numeric_field": {
                                    "avg": {
                                        "field": "moment_annotations.payload_with_explicit_mapping.metadata_number_value"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}