                  {
                      "bool": {
                          "should": [
                              {
                                  "has_child": {
                                      "type": "message",
                                      "query": {
                                          "bool": {
                                              "should": [
                                                  {
                                                      "bool": {
                                                          "minimum_should_match": 1,
                                                          "should": [
                                                              {
                                                                  "bool": {
                                                                      "filter": [
                                                                          {
                                                                              "terms": {
                                                                                  "conversation_to_message_join": [
                                                                                      "message"
                                                                                  ]
                                                                              }
                                                                          }
                                                                      ],
                                                                      "should": [
