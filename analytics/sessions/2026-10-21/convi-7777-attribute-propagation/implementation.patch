+func (s *ConversationAssistanceUsageEvidenceCHTestSuite) TestRPCFiltersFeatureRowsWithinEligiblePopulation() {
+	for featureIndex, feature := range []string{"KB search", "Chat Suggestions", "GenAI", "Summary", "Hints", "Notes", "Guided Workflow"} {
+		s.Run(feature, func() {
+			// Given
+			start := time.Date(2021, 10, 1, 0, 0, 0, 0, time.UTC).Add(time.Duration(featureIndex) * 24 * time.Hour)
+			matching := s.seedAssistanceUsageAttributeFeature(feature, start, true /* matches */)
+			nonmatching := s.seedAssistanceUsageAttributeFeature(feature, start, false /* matches */)
+			conv := s.GetConversationConnection(s.customerID, s.profileID)
+			for _, pair := range []conversationAssistanceUsagePopulationRow{matching, nonmatching} {
+				s.Require().NoError(conv.Exec(s.T().Context(), `INSERT INTO conversation_d (conversation_id,agent_user_id,conversation_start_time,update_time,usecase_id) VALUES (?,'1',?,?,'sales')`, pair.conversationID, start, start))
+				s.Require().NoError(conv.Exec(s.T().Context(), `INSERT INTO message_d (message_id,conversation_id,agent_user_id,conversation_start_time,usecase_id) VALUES (?,?,'1',?,'sales')`, uuid.NewString(), pair.conversationID, start))
+			}
+			request := &analyticspb.RetrieveConversationAssistanceUsageStatsRequest{Parent: s.profileResourceName, FilterByTimeRange: &analyticspb.TimeRange{StartTimestamp: timestamppb.New(start), EndTimestamp: timestamppb.New(start.Add(time.Hour))}, FilterByAttribute: &analyticspb.Attribute{UsecaseNames: []string{s.profileResourceName + "/usecases/sales"}, Users: []*userpb.User{{Name: s.customerResourceName + "/users/1"}}}}
+			original := proto.Clone(request)
+			expected := &analyticspb.RetrieveConversationAssistanceUsageStatsResponse{TotalConversationCount: 2, ConversationsWithAssistanceUsedCount: 1, ConversationAssistanceUsageStatsResults: []*analyticspb.ConversationAssistanceUsageStatsResult{{TotalConversationCount: 2, ConversationsWithAssistanceUsedCount: 1}}}
+
+			// When
+			actual, err := s.server.RetrieveConversationAssistanceUsageStats(s.T().Context(), request)
+
+			// Then
+			s.Require().NoError(err)
+			sharedassert.CmpEquals(s.T(), expected, actual)
+			sharedassert.CmpEquals(s.T(), original, request)
+		})
+	}
+}
