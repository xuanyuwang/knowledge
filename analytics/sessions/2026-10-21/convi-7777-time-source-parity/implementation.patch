+							s.Require().NoError(events.Exec(s.T().Context(), `INSERT INTO conversation_event_d (event_id,conversation_id,agent_user_id,conversation_start_time,event_type,event_payload) VALUES (?,?,'1',?,4,?)`, uuid.NewString(), conversationID, start, `{"usedKbDocument":{"document":"doc","docType":"2","sessionMetadata":{"sessionId":"session"}}}`))
+						}
+					}
+					attribute := &analyticspb.Attribute{}
+					if metadata {
+						attribute.MomentGroups = []*analyticspb.MomentGroup{{Moments: []*momentpb.Moment{{Name: s.profileResourceName + "/moments/source", Type: momentpb.Moment_CONVERSATION_METADATA}}, MetadataValueAttributes: []*analyticspb.MetadataValueAttribute{{MetadataValue: &metadatapb.MetadataValue{Value: &metadatapb.MetadataValue_StringValue{StringValue: "selected"}}}}}}
+					}
+					if metadataMode == "Exclude" {
+						attribute.MomentGroups = []*analyticspb.MomentGroup{{ExcludedMoments: []*momentpb.Moment{{Name: s.profileResourceName + "/moments/absent", Type: momentpb.Moment_CONVERSATION_METADATA}}}}
+					}
+					if metadataMode == "ValueOrMissing" {
+						attribute.MomentGroups[0].ExcludedMoments = attribute.MomentGroups[0].Moments
+					}
+					request := &analyticspb.RetrieveConversationAssistanceUsageStatsRequest{Parent: s.profileResourceName, FilterByTimeRange: &analyticspb.TimeRange{StartTimestamp: timestamppb.New(start), EndTimestamp: timestamppb.New(start.Add(time.Hour))}, FilterByAttribute: attribute}
+					want := int32(0)
+					if metadata == conversationsSource {
+						want = 1
+					}
+
+					queries := assistanceUsageQueriesForTest(s.T(), request, true /* includeBotConversations */)
+					featureName := feature
+					if feature == "Workflow" {
+						featureName = "Guided Workflow"
+					}
+					var selected assistanceUsageEvidenceQuery
+					for _, query := range queries {
+						if query.name == featureName {
+							selected = query
+						}
+					}
+					population := []conversationAssistanceUsagePopulationRow{{conversationID: conversationID, agentUserID: "1"}}
+					parent := &shared.CustomerProfile{CustomerID: s.customerID, ProfileID: s.profileID}
+
+					// When
+					pairs, err := s.server.readConversationAssistanceUsageFeature(s.T().Context(), parent, population, []string{"1"}, selected)
+
+					// Then
+					s.Require().NoError(err)
+					s.Len(pairs, int(want))
+				})
+			}
+		}
+	}
+}
+
+func assistanceUsageQueriesForTest(t *testing.T, req *analyticspb.RetrieveConversationAssistanceUsageStatsRequest, includeBots bool) []assistanceUsageEvidenceQuery {
+	t.Helper()
+	if req == nil {
+		start := time.Date(2021, 1, 6, 7, 30, 0, 0, time.UTC)
+		req = &analyticspb.RetrieveConversationAssistanceUsageStatsRequest{FilterByTimeRange: &analyticspb.TimeRange{StartTimestamp: timestamppb.New(start), EndTimestamp: timestamppb.New(start.Add(24 * time.Hour))}}
+	}
+	queries, err := conversationAssistanceUsageEvidenceQueries(includeBots, req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return queries
+}
