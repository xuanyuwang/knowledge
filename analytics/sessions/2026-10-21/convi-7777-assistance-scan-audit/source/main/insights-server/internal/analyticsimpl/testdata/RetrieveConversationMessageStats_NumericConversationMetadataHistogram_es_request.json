{
    "query": {
        "bool": {
            "filter": [
                {
                    "range": {
                        "conversation_started_at": {
                            "gte": "2022-04-13T00:00:00Z",
                            "lt": "2022-07-13T00:00:00Z",
                            "time_zone": "+00:00"
                        }
                    }
                },
                {
                    "bool": {
                        "should": [
                            {
                                "terms": {
                                    "conversation_source": [
                                        0,
                                        7,
                                        8
                                    ]
                                }
                            },
                            {
                                "bool": {
                                    "must_not": {
                                        "exists": {
                                            "field": "conversation_source"
                                        }
                                    }
                                }
                            }
                        ]
                    }
                },
                {
                    "nested": {
                        "path": "moment_annotations",
                        "query": {
                            "bool": {
                                "filter": [
                                    {
                                        "terms": {
                                            "moment_annotations.moment_template_id.keyword": [
                                                "manual_kpi_1"
                                            ]
                                        }
                                    }
                                ],
                                "should": [
                                    {
                                        "range": {
                                            "moment_annotations.payload_with_explicit_mapping.metadata_number_value": {
                                                "gte": 0,
                                                "lt": 20
                                            }
                                        }
                                    },
                                    {
                                        "range": {
                                            "moment_annotations.payload_with_explicit_mapping.metadata_number_value": {
                                                "gt": 100,
                                                "lte": 200
                                            }
                                        }
                                    }
                                ],
                                "minimum_should_match": 1
                            }
                        }
                    }
                },
                {
                    "terms": {
                        "conversation_to_message_join": [
                            "conversation"
                        ]
                    }
                },
                {
                    "range": {
                        "message_count": {
                            "gt": 0
                        }
                    }
                }
            ]
        }
    },
    "aggs": {
        "total_conversation_count": {
            "cardinality": {
                "field": "conversation_id.keyword",
                "precision_threshold": 40000
            }
        },
        "total_conversation_message_count": {
            "cardinality": {
                "script": {
                    "source": "return [doc['conversation_id.keyword'] + '-' + doc['conversation_message_id.keyword']]"
                },
                "precision_threshold": 40000
            }
        },
        "total_conversation_handle_time_secs_sum": {
            "sum": {
                "field": "handle_time_secs"
            }
        },
        "moments": {
            "filters": {
                "filters": [
                    {
                        "nested": {
                            "path": "moment_annotations",
                            "query": {
                                "bool": {
                                    "filter": [
                                        {
                                            "terms": {
                                                "moment_annotations.moment_template_id.keyword": [
                                                    "manual_kpi_1"
                                                ]
                                            }
                                        }
                                    ],
                                    "should": [
                                        {
                                            "range": {
                                                "moment_annotations.payload_with_explicit_mapping.metadata_number_value": {
                                                    "gte": 0,
                                                    "lt": 20
                                                }
                                            }
                                        }
                                    ],
                                    "minimum_should_match": 1
                                }
                            }
                        }
                    },
                    {
                        "nested": {
                            "path": "moment_annotations",
                            "query": {
                                "bool": {
                                    "filter": [
                                        {
                                            "terms": {
                                                "moment_annotations.moment_template_id.keyword": [
                                                    "manual_kpi_1"
                                                ]
                                            }
                                        }
                                    ],
                                    "should": [
                                        {
                                            "range": {
                                                "moment_annotations.payload_with_explicit_mapping.metadata_number_value": {
                                                    "gt": 100,
                                                    "lte": 200
                                                }
                                            }
                                        }
                                    ],
                                    "minimum_should_match": 1
                                }
                            }
                        }
                    }
                ]
            },
            "aggs": {
                "total_conversation_count": {
                    "cardinality": {
                        "field": "conversation_id.keyword",
                        "precision_threshold": 40000
                    }
                },
                "total_conversation_message_count": {
                    "cardinality": {
                        "script": {
                            "source": "return [doc['conversation_id.keyword'] + '-' + doc['conversation_message_id.keyword']]"
                        },
                        "precision_threshold": 40000
                    }
                },
                "total_conversation_handle_time_secs_sum": {
                    "sum": {
                        "field": "handle_time_secs"
                    }
                },
                "annotation_hit": {
                    "top_hits": {
                        "size": 1,
                        "_source": {
                            "includes": [
                                "moment_annotations"
                            ]
                        }
                    }
                }
            }
        }
    }
}