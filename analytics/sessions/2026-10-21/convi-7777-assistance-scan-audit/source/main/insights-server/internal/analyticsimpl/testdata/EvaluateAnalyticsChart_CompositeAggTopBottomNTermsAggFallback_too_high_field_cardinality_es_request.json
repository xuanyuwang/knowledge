{
  "query": {
    "bool": {
      "filter": [
        {
          "terms": {
            "conversation_to_message_join": [
              "conversation"
            ]
          }
        },
        {
          "terms": {
            "conversation_source": [
              0,
              7,
              8
            ]
          }
        },
        {
          "range": {
            "message_count": {
              "gt": 0
            }
          }
        },
        {
          "bool": {
            "filter": {
              "bool": {
                "should": [
                  {
                    "range": {
                      "conversation_started_at": {
                        "gte": "2024-07-01T00:00:00Z",
                        "lt": "2024-10-15T00:00:00Z",
                        "time_zone": "+00:00"
                      }
                    }
                  }
                ],
                "minimum_should_match": 1
              }
            }
          }
        },
        {
          "bool": {
            "filter": {
              "bool": {
                "should": [
                  {
                    "nested": {
                      "path": "scorecards",
                      "query": {
                        "bool": {
                          "filter": [
                            {
                              "terms": {
                                "scorecards.template_id.keyword": [
                                  "scorecard_template_1"
                                ]
                              }
                            },
                            {
                              "nested": {
                                "path": "scorecards.scorecard_scores",
                                "query": {
                                  "terms": {
                                    "scorecards.scorecard_scores.criterion_id.keyword": [
                                      "test-criterion-id1",
                                      "test-criterion-id2"
                                    ]
                                  }
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  }
                ],
                "minimum_should_match": 1
              }
            }
          }
        }
      ]
    }
  },
  "aggs": {
    "metrics_bucket_field_cardinality": {
      "cardinality": {
        "field": "agent_user_id.keyword",
        "precision_threshold": 40000
      }
    }
  }
}
