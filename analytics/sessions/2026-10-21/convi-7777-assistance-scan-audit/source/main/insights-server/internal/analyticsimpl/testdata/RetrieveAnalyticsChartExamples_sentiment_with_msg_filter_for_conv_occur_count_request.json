{
    "_source": {
        "excludes": [
            "moment_annotations",
            "action_annotations",
            "conversation_events",
            "scorecards"
        ]
    },
    "query": {
        "bool": {
            "filter": [
                {
                    "terms": {
                        "conversation_to_message_join": [
                            "conversation"
                        ]
                    }
                },
                {
                    "terms": {
                        "conversation_source": [
                            0,
                            7,
                            8
                        ]
                    }
                },
                {
                    "range": {
                        "message_count": {
                            "gt": 0
                        }
                    }
                },
                {
                    "bool": {
                        "filter": {
                            "bool": {
                                "should": [
                                    {
                                        "has_child": {
                                            "type": "message",
                                            "query": {
                                                "bool": {
                                                    "filter": [
                                                        {
                                                            "nested": {
                                                                "path": "moment_annotations",
                                                                "query": {
                                                                    "bool": {
                                                                        "filter": [
                                                                            {
                                                                                "terms": {
                                                                                    "moment_annotations.moment_template_id.keyword": [
                                                                                        "sentiment-1",
                                                                                        "sentiment-2"
                                                                                    ]
                                                                                }
                                                                            }
                                                                        ]
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    ]
                                                }
                                            }
                                        }
                                    }
                                ],
                                "minimum_should_match": 1
                            }
                        }
                    }
                },
                {
                    "bool": {
                        "filter": {
                            "bool": {
                                "should": [
                                    {
                                        "terms": {
                                            "usecase_id.keyword": [
                                                "usecase-1",
                                                "usecase-2"
                                            ]
                                        }
                                    }
                                ],
                                "minimum_should_match": 1
                            }
                        }
                    }
                }
            ]
        }
    },
    "sort": [
        {
            "conversation_ended_at": {
                "format": "strict_date_optional_time_nanos",
                "order": "desc"
            }
        }
    ]
}