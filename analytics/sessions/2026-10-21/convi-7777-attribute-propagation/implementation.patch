+func (s *ConversationAssistanceUsageEvidenceCHTestSuite) seedAssistanceUsageAttributeFeature(feature string, start time.Time, matches bool) conversationAssistanceUsagePopulationRow {
+	s.T().Helper()
+	conversationID := uuid.NewString()
+	language, usecase, duration, voicemail := "en-US", "sales", 90, false
+	if !matches {
+		language, usecase, duration, voicemail = "fr", "support", 30, true
+	}
+	conv := s.GetConversationConnection(s.customerID, s.profileID)
+	events := s.GetEventsConnection(s.customerID, s.profileID)
+	args := []any{conversationID, start, language, usecase, duration, voicemail}
+	s.Require().NoError(conv.Exec(s.T().Context(), `INSERT INTO conversation_d (conversation_id,agent_user_id,conversation_start_time,language_code,usecase_id,conversation_duration_secs,is_voice_mail) VALUES (?,'1',?,?,?,?,?)`, args...))
+	switch feature {
+	case "KB search", "Chat Suggestions":
+		eventType := 13
+		if feature == "Chat Suggestions" {
+			eventType = 4
+		}
+		s.Require().NoError(conv.Exec(s.T().Context(), `INSERT INTO conversation_event_d (conversation_id,agent_user_id,conversation_start_time,language_code,usecase_id,conversation_duration_secs,is_voice_mail,event_id,event_type) VALUES (?,'1',?,?,?,?,?,?,?)`, append(args, uuid.NewString(), eventType)...))
+	case "GenAI":
+		s.Require().NoError(conv.Exec(s.T().Context(), `INSERT INTO moment_annotation_d (conversation_id,agent_user_id,conversation_start_time,language_code,usecase_id,conversation_duration_secs,is_voice_mail,moment_annotation_id,moment_type,knowledge_payload_knowledge_session_id) VALUES (?,'1',?,?,?,?,?,?,38,'session')`, append(args, uuid.NewString())...))
+	case "Summary":
+		s.Require().NoError(conv.Exec(s.T().Context(), `INSERT INTO action_annotation_d (conversation_id,agent_user_id,conversation_start_time,language_code,usecase_id,conversation_duration_secs,is_voice_mail,action_annotation_id,summarization_payload_is_valid_summary) VALUES (?,'1',?,?,?,?,?,?,1)`, append(args, uuid.NewString())...))
+		s.Require().NoError(conv.Exec(s.T().Context(), `INSERT INTO conversation_event_d (conversation_id,agent_user_id,conversation_start_time,language_code,usecase_id,conversation_duration_secs,is_voice_mail,event_id,event_type,summarization_payload_data_type) VALUES (?,'1',?,?,?,?,?,?,16,1)`, append(args, uuid.NewString())...))
+	case "Hints":
+		s.Require().NoError(conv.Exec(s.T().Context(), `INSERT INTO moment_annotation_d (conversation_id,agent_user_id,conversation_start_time,language_code,usecase_id,conversation_duration_secs,is_voice_mail,moment_annotation_id,adherence_action_annotation_id,adherence_type,adherence_action_type,adherence_action_adherence_type,adherence_action_policy_source_type) VALUES (?,'1',?,?,?,?,?,?,?,2,1,1,1)`, append(args, uuid.NewString(), uuid.NewString())...))
+	case "Notes", "Guided Workflow":
+		s.Require().NoError(events.Exec(s.T().Context(), `INSERT INTO conversation_d (conversation_id,agent_user_id,conversation_start_time,language_code,usecase_id,conversation_duration_secs,is_voice_mail) VALUES (?,'1',?,?,?,?,?)`, args...))
+		eventType, eventName, payload := 5, "VoiceAgentAssist.NoteTaking.Click.CopyEntity", "{}"
+		if feature == "Guided Workflow" {
+			eventType, eventName, payload = 4, "", `{"usedKbDocument":{"document":"doc","docType":"2","sessionMetadata":{"sessionId":"session"}}}`
+		}
+		s.Require().NoError(events.Exec(s.T().Context(), `INSERT INTO conversation_event_d (conversation_id,agent_user_id,conversation_start_time,usecase_id,event_id,event_type,event_name,event_payload) VALUES (?,'1',?,?,?,?,?,?)`, conversationID, start, usecase, uuid.NewString(), eventType, eventName, payload))
+	}
+	return conversationAssistanceUsagePopulationRow{conversationID: conversationID, agentUserID: "1", conversationTime: start}
+}
