                                                  "type": "phrase",
                                                  "fields": [
                                                    "message_text"
                                                  ]
                                                }
                                              },
                                              {
                                                "multi_match": {
                                                  "query": "moment_1_keyword_excluded_2",
                                                  "type": "phrase",
                                                  "fields": [
                                                    "message_text"
