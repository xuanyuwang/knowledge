                                          "bool": {
                                              "should": [
                                                  {
                                                      "bool": {
                                                          "must_not": [
                                                              {
                                                                  "bool": {
                                                                      "should": [
                                                                          {
                                                                              "multi_match": {
                                                                                  "query": "moment_1_keyword_excluded_1",
                                                                                  "type": "phrase",
                                                                                  "fields": [
                                                                                      "message_text"
                                                                                  ]
                                                                              }
                                                                          },
                                                                          {
                                                                              "multi_match": {
                                                                                  "query": "moment_1_keyword_excluded_2",
