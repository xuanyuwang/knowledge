{
    "_source": {
        "includes": [
            "conversation_id",
            "moment_annotations",
            "message_count"
        ]
    },
    "query": {
        "bool": {
            "filter": [
                {
                    "range": {
                        "conversation_started_at": {
                            "gte": "2022-04-13T00:00:00Z",
                            "lt": "2022-07-13T00:00:00Z",
                            "time_zone": "-10:00"
                        }
                    }
                },
                {
                    "bool": {
                        "should": [
                            {
                                "terms": {
                                    "conversation_source": [
                                        0,
                                        7,
                                        8
                                    ]
                                }
                            },
                            {
                                "bool": {
                                    "must_not": {
                                        "exists": {
                                            "field": "conversation_source"
                                        }
                                    }
                                }
                            }
                        ]
                    }
                },
                {
                    "terms": {
                        "agent_user_id.keyword": [
                            "2f540f161f3a452c",
                            "35636a572d7ec364",
                            "d072a51a8359fe51",
                            "user-id4-deactivated"
                        ]
                    }
                },
                {
                    "bool": {
                        "should": [
                            {
                                "function_score": {
                                    "query": {
                                        "bool": {
                                            "filter": [
                                                {
                                                    "range": {
                                                        "truncated_minute_of_day": {
                                                            "gte": 540,
                                                            "lte": 1020
                                                        }
                                                    }
                                                },
                                                {
                                                    "range": {
                                                        "truncated_day_of_week": {
                                                            "gte": 1,
                                                            "lte": 5
                                                        }
                                                    }
                                                }
                                            ]
                                        }
                                    }
                                }
                            }
                        ],
                        "minimum_should_match": 1
                    }
                },
                {
                    "terms": {
                        "conversation_to_message_join": [
                            "conversation"
                        ]
                    }
                },
                {
                    "range": {
                        "message_count": {
                            "gt": 0
                        }
                    }
                }
            ]
        }
    },
    "sort": [
        {
            "conversation_ended_at": {
                "format": "strict_date_optional_time_nanos",
                "order": "desc"
            }
        },
        {
            "conversation_id.keyword": {
                "order": "asc"
            }
        }
    ],
    "runtime_mappings": {
        "truncated_day_of_week": {
            "type": "long",
            "script": {
                "source": "def z=params.tz; def id=(z.startsWith('+')||z.startsWith('-')) ? ZoneOffset.of(z) : ZoneId.of(z); def v=doc['conversation_started_at'].value.withZoneSameInstant(id); emit(v.getDayOfWeek().getValue())",
                "params": {
                    "tz": "-10:00"
                }
            }
        },
        "truncated_minute_of_day": {
            "type": "long",
            "script": {
                "source": "def z=params.tz; def id=(z.startsWith('+')||z.startsWith('-')) ? ZoneOffset.of(z) : ZoneId.of(z); def v=doc['conversation_started_at'].value.withZoneSameInstant(id); emit(v.getHour()*60 + v.getMinute())",
                "params": {
                    "tz": "-10:00"
                }
            }
        }
    }
}