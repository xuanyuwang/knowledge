{
    "query": {
        "bool": {
            "filter": [
                {
                    "range": {
                        "conversation_started_at": {
                            "gte": "2022-07-01T00:00:00Z",
                            "lt": "2022-07-10T00:00:00Z",
                            "time_zone": "+00:00"
                        }
                    }
                },
                {
                    "bool": {
                        "should": [
                            {
                                "terms": {
                                    "conversation_source": [
                                        0,
                                        7,
                                        8
                                    ]
                                }
                            },
                            {
                                "bool": {
                                    "must_not": {
                                        "exists": {
                                            "field": "conversation_source"
                                        }
                                    }
                                }
                            }
                        ]
                    }
                },
                {
                    "terms": {
                        "conversation_to_message_join": [
                            "conversation"
                        ]
                    }
                }
            ]
        }
    },
    "aggs": {
        "time_ranges": {
            "date_histogram": {
                "field": "conversation_started_at",
                "time_zone": "+00:00",
                "calendar_interval": "day"
            },
            "aggs": {
                "moments": {
                    "filters": {
                        "filters": [
                            {
                                "has_child": {
                                    "type": "message",
                                    "query": {
                                        "bool": {
                                            "filter": [
                                                {
                                                    "nested": {
                                                        "path": "moment_annotations",
                                                        "query": {
                                                            "bool": {
                                                                "filter": [
                                                                    {
                                                                        "terms": {
                                                                            "moment_annotations.moment_template_id.keyword": [
                                                                                "cat-1",
                                                                                "cat-1-1",
                                                                                "cat-1-2",
                                                                                "cat-1-2-1"
                                                                            ]
                                                                        }
                                                                    }
                                                                ]
                                                            }
                                                        }
                                                    }
                                                }
                                            ]
                                        }
                                    }
                                }
                            }
                        ]
                    }
                }
            }
        }
    }
}
