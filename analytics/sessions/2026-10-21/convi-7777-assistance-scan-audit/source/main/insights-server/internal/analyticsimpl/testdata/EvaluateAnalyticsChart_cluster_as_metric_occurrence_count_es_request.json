{
    "query": {
        "bool": {
            "filter": [
                {
                    "terms": {
                        "conversation_to_message_join": [
                            "conversation"
                        ]
                    }
                },
                {
                    "terms": {
                        "conversation_source": [
                            0,
                            7,
                            8
                        ]
                    }
                },
                {
                    "range": {
                        "message_count": {
                            "gt": 0
                        }
                    }
                },
                {
                    "bool": {
                        "filter": {
                            "bool": {
                                "should": [
                                    {
                                        "range": {
                                            "conversation_started_at": {
                                                "gte": "2024-07-01T00:00:00Z",
                                                "lt": "2024-10-01T00:00:00Z",
                                                "time_zone": "+00:00"
                                            }
                                        }
                                    }
                                ],
                                "minimum_should_match": 1
                            }
                        }
                    }
                },
                {
                    "bool": {
                        "filter": {
                            "bool": {
                                "should": [
                                    {
                                        "has_child": {
                                            "type": "message_group",
                                            "query": {
                                                "bool": {
                                                    "filter": [
                                                        {
                                                            "nested": {
                                                                "path": "moment_annotations",
                                                                "query": {
                                                                    "bool": {
                                                                        "filter": [
                                                                            {
                                                                                "terms": {
                                                                                    "moment_annotations.moment_template_id.keyword": [
                                                                                        "cluster-1"
                                                                                    ]
                                                                                }
                                                                            }
                                                                        ]
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    ]
                                                }
                                            }
                                        }
                                    }
                                ],
                                "minimum_should_match": 1
                            }
                        }
                    }
                }
            ]
        }
    },
    "aggs": {
        "bucket_aggs": {
            "terms": {
                "field": "agent_user_id.keyword",
                "size": 1000,
                "order": {
                    "_count": "desc"
                }
            },
            "aggs": {
                "bucket_aggs": {
                    "children": {
                        "type": "message_group"
                    },
                    "aggs": {
                        "bucket_aggs": {
                            "filter": {
                                "nested": {
                                    "path": "moment_annotations",
                                    "query": {
                                        "bool": {
                                            "filter": [
                                                {
                                                    "terms": {
                                                        "moment_annotations.moment_template_id.keyword": [
                                                            "cluster-1"
                                                        ]
                                                    }
                                                }
                                            ]
                                        }
                                    }
                                }
                            },
                            "aggs": {
                                "metrics_conversation_message_count": {
                                    "cardinality": {
                                        "script": {
                                            "source": "return [doc['conversation_id.keyword'] + '-' + doc['conversation_message_id.keyword']]"
                                        },
                                        "precision_threshold": 40000
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
