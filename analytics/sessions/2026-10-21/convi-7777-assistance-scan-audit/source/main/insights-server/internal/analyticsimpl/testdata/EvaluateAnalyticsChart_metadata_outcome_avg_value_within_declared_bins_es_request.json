{
    "query": {
        "bool": {
            "filter": [
                {
                    "terms": {
                        "conversation_to_message_join": [
                            "conversation"
                        ]
                    }
                },
                {
                    "terms": {
                        "conversation_source": [
                            0,
                            7,
                            8
                        ]
                    }
                },
                {
                    "range": {
                        "message_count": {
                            "gt": 0
                        }
                    }
                },
                {
                    "bool": {
                        "filter": {
                            "bool": {
                                "should": [
                                    {
                                        "range": {
                                            "conversation_started_at": {
                                                "gte": "2024-07-01T00:00:00Z",
                                                "lt": "2024-11-15T00:00:00Z",
                                                "time_zone": "+00:00"
                                            }
                                        }
                                    }
                                ],
                                "minimum_should_match": 1
                            }
                        }
                    }
                },
                {
                    "bool": {
                        "filter": {
                            "bool": {
                                "should": [
                                    {
                                        "nested": {
                                            "path": "moment_annotations",
                                            "query": {
                                                "bool": {
                                                    "filter": [
                                                        {
                                                            "terms": {
                                                                "moment_annotations.moment_template_id.keyword": [
                                                                    "metadata-1"
                                                                ]
                                                            }
                                                        }
                                                    ]
                                                }
                                            }
                                        }
                                    }
                                ],
                                "minimum_should_match": 1
                            }
                        }
                    }
                }
            ]
        }
    },
    "aggs": {
        "bucket_aggs": {
            "date_histogram": {
                "field": "conversation_started_at",
                "time_zone": "+00:00",
                "calendar_interval": "day",
                "min_doc_count": 0,
                "extended_bounds": {
                    "min": "2024-07-01T00:00:00Z",
                    "max": "2024-11-15T00:00:00Z"
                }
            },
            "aggs": {
                "bucket_aggs": {
                    "nested": {
                        "path": "moment_annotations"
                    },
                    "aggs": {
                        "bucket_aggs": {
                            "filter": {
                                "bool": {
                                    "filter": [
                                        {
                                            "terms": {
                                                "moment_annotations.moment_template_id.keyword": [
                                                    "metadata-1"
                                                ]
                                            }
                                        },
                                        {
                                            "range": {
                                                "moment_annotations.payload_with_explicit_mapping.outcome_number_value": {
                                                    "gte": 2,
                                                    "lte": 10
                                                }
                                            }
                                        }
                                    ]
                                }
                            },
                            "aggs": {
                                "metrics_agg_on_numeric_field": {
                                    "avg": {
                                        "field": "moment_annotations.payload_with_explicit_mapping.outcome_number_value"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
