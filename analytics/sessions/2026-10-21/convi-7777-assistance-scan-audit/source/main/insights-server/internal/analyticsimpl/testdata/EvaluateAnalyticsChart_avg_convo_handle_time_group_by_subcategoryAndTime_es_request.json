                                                                                  ]
                                                                              }
                                                                          },
                                                                          {
                                                                              "multi_match": {
                                                                                  "query": "moment_1_keyword_excluded_2",
                                                                                  "type": "phrase",
                                                                                  "fields": [
                                                                                      "message_text"
                                                                                  ]
                                                                              }
                                                                          }
                                                                      ]
                                                                  }
                                                              }
                                                          ],
                                                          "minimum_should_match": 1,
                                                          "should": [
                                                              {
                                                                  "bool": {
                                                                      "filter": [
                                                                          {
                                                                              "terms": {
                                                                                  "conversation_to_message_join": [
                                                                                      "message"
                                                                                  ]
                                                                              }
                                                                          }
                                                                      ],
                                                                      "should": [
                                                                          {
                                                                              "multi_match": {
                                                                                  "query": "moment_1_keyword_included_2",
                                                                                  "type": "phrase",
                                                                                  "fields": [
                                                                                      "message_text"
                                                                                  ]
                                                                              }
                                                                          }
                                                                      ],
                                                                      "minimum_should_match": 1
                                                                  }
                                                              }
                                                          ]
                                                      }
                                                  }
                                              ],
                                              "minimum_should_match": 1
                                          }
                                      }
                                  }
                              },
                              {
                                  "has_child": {
                                      "type": "message_group",
